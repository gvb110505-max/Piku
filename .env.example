# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 커밋하지 않는다.
# Supabase 대시보드 → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 주의: EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 포함된다.
# service_role 키, LiveKit API secret 같은 비밀키는 절대 여기에 넣지 말 것
# (서버 쪽 Supabase Edge Function 시크릿으로만 설정한다).
