# Edge Function 비밀값. 로컬: 이 파일을 supabase/functions/.env 로 복사 (커밋 금지)
# 운영: npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 는 Supabase 가 자동 주입)

# ── LiveKit (필수) ─────────────────────────────────────────
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 서버에서 LiveKit API 에 접속하는 주소가 LIVEKIT_URL 과 다를 때만 (예: 로컬 Docker http://livekit:7880)
# LIVEKIT_API_URL=

# ── 주기 정리 작업(call-sweep) 호출 비밀값 (필수, 긴 랜덤 문자열) ──
CALL_SWEEP_SECRET=

# ── iOS 수신 전화: APNs VoIP (실기기 수신 테스트 시 필수) ──
# Apple Developer → Keys 에서 APNs 키(.p8) 생성
APNS_KEY_ID=
APNS_TEAM_ID=
# .p8 파일 내용 (줄바꿈은 \n 으로)
APNS_PRIVATE_KEY=
# app.json 의 ios.bundleIdentifier
APNS_BUNDLE_ID=com.callsns.app
# Dev Build = sandbox, TestFlight/스토어 = production
APNS_ENV=sandbox

# ── Android 수신 전화: FCM (실기기 수신 테스트 시 필수) ──
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 (JSON 한 줄로)
FCM_SERVICE_ACCOUNT=

# ── 부재중 알림 등 일반 푸시: Expo Push (선택. Expo 계정에서 Enhanced Security 켰을 때만 필요) ──
# EXPO_ACCESS_TOKEN=
